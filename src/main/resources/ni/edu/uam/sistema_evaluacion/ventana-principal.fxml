<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="480.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sistema_evaluacion.controller.VentanaPrincipalController">
    <top>
        <VBox>
            <children>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Clientes">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#abrirRegistro" text="Registrar cliente" />
                                <MenuItem mnemonicParsing="false" onAction="#abrirConsulta" text="Consultar clientes" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar>
                    <items>
                        <Button mnemonicParsing="false" onAction="#abrirRegistro" text="Registrar cliente" />
                        <Button mnemonicParsing="false" onAction="#abrirConsulta" text="Consultar clientes" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Sistema de Solicitudes">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Separator prefWidth="400.0" />
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Seleccione una opción" />
                <HBox alignment="CENTER" spacing="24.0">
                    <children>
                        <Button fx:id="btnRegistrarCliente" mnemonicParsing="false" onAction="#abrirRegistro" prefHeight="56.0" prefWidth="200.0" text="Registrar cliente" />
                        <Button fx:id="btnConsultarClientes" mnemonicParsing="false" onAction="#abrirConsulta" prefHeight="56.0" prefWidth="200.0" text="Consultar clientes">
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#abrirConsulta" text="Abrir consulta de clientes" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
