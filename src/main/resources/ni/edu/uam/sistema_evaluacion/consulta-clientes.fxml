<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.sistema_evaluacion.controller.ConsultaClientesController"
            prefHeight="560.0" prefWidth="900.0">
    <children>
        <Label layoutX="20.0" layoutY="18.0" text="Consulta de clientes"/>
        <TableView fx:id="tablaClientes" layoutX="20.0" layoutY="50.0"
                   prefHeight="450.0" prefWidth="860.0"
                   onMouseClicked="#alHacerClicEnTabla"
                   AnchorPane.topAnchor="50.0"
                   AnchorPane.rightAnchor="20.0"
                   AnchorPane.bottomAnchor="50.0"
                   AnchorPane.leftAnchor="20.0">
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre completo"/>
                <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de cliente"/>
                <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad"/>
                <TableColumn fx:id="colFechaNacimiento" prefWidth="160.0" text="Fecha de nacimiento"/>
                <TableColumn fx:id="colTipoSolicitud" prefWidth="180.0" text="Tipo de solicitud"/>
            </columns>
        </TableView>
        <Label fx:id="lblSeleccion" layoutX="20.0" layoutY="520.0"
               text="Seleccione un cliente. Doble clic para ver o editar el detalle."
               AnchorPane.bottomAnchor="18.0" AnchorPane.leftAnchor="20.0"/>
    </children>
</AnchorPane>
