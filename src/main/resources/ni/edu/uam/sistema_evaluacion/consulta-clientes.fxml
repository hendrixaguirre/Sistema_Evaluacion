<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sistema_evaluacion.controller.ConsultaClientesController">
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="8.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <Label text="Consulta de clientes">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Label text="Doble clic en un cliente para ver o editar su detalle." />
                <Separator />
            </children>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaClientes" onMouseClicked="#alHacerClicEnTabla" prefHeight="450.0" prefWidth="872.0">
            <BorderPane.margin>
                <Insets left="24.0" right="24.0" />
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre completo" />
                <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de cliente" />
                <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="160.0" text="Fecha de nacimiento" />
                <TableColumn fx:id="colTipoSolicitud" prefWidth="180.0" text="Tipo de solicitud" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="16.0" />
            </padding>
            <children>
                <Label fx:id="lblSeleccion" maxWidth="1.7976931348623157E308" text="Seleccione un cliente. Doble clic para ver o editar el detalle." HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#volverAlMenu" prefHeight="36.0" prefWidth="110.0" text="Volver" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
