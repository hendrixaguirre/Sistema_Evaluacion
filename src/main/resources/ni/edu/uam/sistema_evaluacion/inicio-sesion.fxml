<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="560.0" spacing="18.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.sistema_evaluacion.controller.InicioSesionController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
    <children>
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Sistema de Solicitudes">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <Separator prefWidth="512.0" />
        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Ingrese sus credenciales para continuar" />
        <GridPane alignment="CENTER" hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" minWidth="110.0" prefWidth="120.0" />
                <ColumnConstraints minWidth="260.0" prefWidth="280.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="32.0" prefHeight="36.0" valignment="CENTER" />
                <RowConstraints minHeight="32.0" prefHeight="36.0" valignment="CENTER" />
            </rowConstraints>
            <children>
                <Label text="Usuario" />
                <TextField fx:id="txtUsuario" prefHeight="26.0" prefWidth="280.0" promptText="Ingrese Su Usuario" GridPane.columnIndex="1" />
                <Label text="Contraseña" GridPane.rowIndex="1" />
                <PasswordField fx:id="txtContraseña" prefHeight="26.0" prefWidth="280.0" promptText="Ingrese su contraseña" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
        <HBox alignment="CENTER" spacing="16.0">
            <children>
                <Button fx:id="btnIniciarSesion" mnemonicParsing="false" onAction="#iniciarSesion" prefHeight="36.0" prefWidth="130.0" text="Iniciar Sesion" />
                <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salir" prefHeight="36.0" prefWidth="130.0" text="Salir" />
            </children>
        </HBox>
    </children>
</VBox>
